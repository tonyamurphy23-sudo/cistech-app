# From Supabase: Project Settings > API. The anon key is safe in the browser;
# row level security decides what each signed-in person can see.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave as true until the Supabase (Team plan + HIPAA add-on) and Anthropic BAAs
# are signed. It shows a "sample data only" notice to everyone.
VITE_PROTOTYPE_MODE=true
